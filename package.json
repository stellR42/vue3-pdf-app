{
  "name": "vue3-pdf-app",
  "version": "2.0.0-beta.0",
  "description": "Vue 3 PDF viewer component built on the PDF.js 6.5 viewer: full toolbar, search, thumbnails, annotations, print and download. TypeScript types, nothing to host.",
  "type": "module",
  "module": "dist/vue3-pdf-app.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/vue3-pdf-app.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stellR42/vue3-pdf-app.git"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "tag": "next"
  },
  "keywords": [
    "vue",
    "vue3",
    "vuejs",
    "vue-component",
    "pdf",
    "pdf-viewer",
    "pdfjs",
    "pdf.js",
    "viewer",
    "annotations",
    "typescript",
    "vite"
  ],
  "author": "stellR42",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/stellR42/vue3-pdf-app/issues"
  },
  "homepage": "https://github.com/stellR42/vue3-pdf-app#readme",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:types",
    "build:types": "vue-tsc -p tsconfig.lib.json && node scripts/clean-types.mjs",
    "type-check": "vue-tsc --noEmit",
    "update-pdfjs": "node scripts/update-pdfjs.mjs",
    "format": "prettier --write .",
    "prepublishOnly": "npm run type-check && npm run build"
  },
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@fluent/bundle": "^0.19.1",
    "@fluent/dom": "^0.10.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "core-js": "^3.51.0",
    "postcss": "^8.5.6",
    "postcss-nested": "^7.0.2",
    "prettier": "^3.10.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vue": "^3.5.17",
    "vue-tsc": "^2.2.10"
  }
}
